/* SPDX-License-Identifier: GPL-2.0+ */
/*
 * Load addresses match the existing boot.scr (vendor U-Boot 2015.07 era).
 * DRAM is 0-2 GiB; 0x1f000000-0x1fffffff is the secure monitor (no-map).
 * booti moves an Image with flags bit 3 from 0x80000 to 0x200000.
 * booti decompresses Image.gz to kernel_comp_addr_r with a limit of
 * 10 * kernel_comp_size, which must stay below the relocated U-Boot.
 */
kernel_addr_r=0x00080000
fdt_addr_r=0x10000000
scriptaddr=0x10800000
pxefile_addr_r=0x10900000
ramdisk_addr_r=0x13000000
kernel_comp_addr_r=0x30000000
kernel_comp_size=0x02000000
fdtfile=actions/s900-bubblegum-96.dtb

/* boot.scr passes this to Linux as bg96.uboot=; the vendor U-Boot leaves it empty */
bg96_uboot=mainline

/*
 * HDMI console (s900_video): bg96_hdmi=auto lights it only with a sink,
 * force without one, off never touches the display; modes 720p50, 720p60
 */
stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole
bg96_hdmi=auto
bg96_hdmi_mode=720p50
