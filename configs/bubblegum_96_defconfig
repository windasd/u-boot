CONFIG_ARM=y
CONFIG_COUNTER_FREQUENCY=24000000
CONFIG_INIT_SP_RELATIVE=y
CONFIG_ARCH_OWL=y
CONFIG_SYS_MALLOC_LEN=0x2000000
CONFIG_ENV_SIZE=0x2000
CONFIG_DEFAULT_DEVICE_TREE="bubblegum_96"
CONFIG_MACH_S900=y
CONFIG_DM_RESET=y
CONFIG_SYS_BOOTM_LEN=0x4000000
CONFIG_SYS_LOAD_ADDR=0x7ffc0
CONFIG_IDENT_STRING="\nBubblegum-96"
CONFIG_BOOTSTD_DEFAULTS=y
CONFIG_DISTRO_DEFAULTS=y
CONFIG_BOOTDELAY=1
CONFIG_OF_BOARD_SETUP=y
CONFIG_USE_BOOTARGS=y
CONFIG_BOOTARGS="console=ttyOWL5,115200n8"
CONFIG_BOOTCOMMAND="load mmc 1:2 ${scriptaddr} boot.scr && source ${scriptaddr}; echo bg96: boot.scr failed, trying rescue.scr on p5; load mmc 1:5 ${scriptaddr} rescue.scr && source ${scriptaddr}"
CONFIG_SYS_PBSIZE=1051
# CONFIG_DISPLAY_CPUINFO is not set
# CONFIG_DISPLAY_BOARDINFO is not set
CONFIG_SYS_PROMPT="U-Boot => "
CONFIG_CMD_MD5SUM=y
CONFIG_CMD_MEMINFO=y
CONFIG_CMD_GPT=y
CONFIG_CMD_I2C=y
CONFIG_CMD_MMC=y
CONFIG_CMD_POWEROFF=y
CONFIG_CMD_CACHE=y
# CONFIG_CMD_CLS is not set
CONFIG_CMD_TIMER=y
CONFIG_DM_I2C=y
CONFIG_SYS_I2C_OWL=y
CONFIG_MMC_OWL=y
CONFIG_VIDEO=y
# CONFIG_BACKLIGHT is not set
CONFIG_VIDEO_DAMAGE=y
# CONFIG_VIDEO_BPP8 is not set
# CONFIG_VIDEO_BPP16 is not set
CONFIG_SYS_WHITE_ON_BLACK=y
# CONFIG_PANEL is not set
CONFIG_VIDEO_OWL_S900=y
